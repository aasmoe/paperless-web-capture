{
  "manifest_version": 3,
  "name": "Paperless Web Capture",
  "version": "1.0.0",
  "description": "Capture web pages and PDFs to send to your Paperless-ngx server",
  "permissions": [
    "activeTab",
    "storage",
    "debugger",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
